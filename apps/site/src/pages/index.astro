---
import { resolve } from 'node:path';
import Fuse from 'fuse.js';
import { scanIcons, inlineSvg, type IconDef } from '../../../../scripts/lib.ts';
import '../styles/global.css';

// astro build/dev runs with cwd = apps/site
const icons: IconDef[] = scanIcons(resolve(process.cwd(), '../../icons'));

const categories = [...new Set(icons.map((i) => i.category))].sort().map((name) => ({
  name,
  label: name
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' '),
  count: icons.filter((i) => i.category === name).length,
}));

const searchIndex = icons.map((i) => ({
  name: i.kebabName,
  pascal: i.pascalName,
  category: i.category,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>doodle-icons — 451 hand-drawn SVG icons</title>
    <meta
      name="description"
      content="451 hand-drawn doodle SVG icons across 15 categories, free (CC0) and open source. Components for React, React Native, Vue and Flutter."
    />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✏️</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={import.meta.env.BASE_URL}>doodle<span>-icons</span></a>
      <div class="toolbar">
        <div class="search-wrap">
          <input id="search" type="search" placeholder="Search 451 icons…" autocomplete="off" spellcheck="false" />
          <kbd>/</kbd>
        </div>
        <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme">◐</button>
      </div>
    </header>

    <nav class="chips" aria-label="Categories">
      <button class="chip is-active" data-category="">All <span>{icons.length}</span></button>
      {
        categories.map((c) => (
          <button class="chip" data-category={c.name}>
            {c.label} <span>{c.count}</span>
          </button>
        ))
      }
    </nav>

    <main>
      <p class="count" id="count" role="status" aria-live="polite"></p>
      <div class="grid" id="grid">
        {
          icons.map((icon) => (
            <button
              class="card"
              data-name={icon.kebabName}
              data-pascal={icon.pascalName}
              data-category={icon.category}
              data-viewbox={icon.viewBox}
              type="button"
            >
              <span class="glyph" set:html={inlineSvg(icon)} />
              <span class="name">{icon.kebabName}</span>
            </button>
          ))
        }
      </div>
      <p class="empty" id="empty" hidden>No icons match your search.</p>
    </main>

    <footer class="site-footer">
      <p>
        {icons.length} hand-drawn icons · icons <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a> ·
        packages <a href="https://opensource.org/licenses/MIT">MIT</a>
      </p>
      <p>
        <a href="https://github.com/jian/doodle-icons">GitHub</a> ·
        <a href="https://www.npmjs.com/package/@doodle-icons/react">npm</a> ·
        <a href="https://pub.dev/packages/doodle_icons">pub.dev</a>
      </p>
    </footer>

    <dialog id="modal">
      <div class="modal-inner">
        <button id="modal-close" class="icon-btn" aria-label="Close">✕</button>
        <div class="preview" id="preview"></div>
        <div class="sizes" role="group" aria-label="Preview size">
          <button data-size="32">32</button>
          <button data-size="64" class="is-active">64</button>
          <button data-size="128">128</button>
        </div>
        <h2 id="modal-name"></h2>
        <p class="meta" id="modal-meta"></p>
        <div class="copy-grid" id="copy-grid">
          <button data-what="svg">SVG</button>
          <button data-what="react">React</button>
          <button data-what="vue">Vue</button>
          <button data-what="rn">React Native</button>
          <button data-what="flutter">Flutter</button>
          <a id="download" download="">Download</a>
        </div>
      </div>
    </dialog>

    <script>
      import Fuse from 'fuse.js';

      const searchIndex = JSON.parse(
        document.getElementById('search-index')?.textContent ?? 'null',
      );

      const grid = document.getElementById('grid') as HTMLElement;
      const cards = [...grid.querySelectorAll<HTMLButtonElement>('.card')];
      const search = document.getElementById('search') as HTMLInputElement;
      const countEl = document.getElementById('count') as HTMLElement;
      const emptyEl = document.getElementById('empty') as HTMLElement;
      const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];

      const fuse = new Fuse(searchIndex, {
        keys: [
          { name: 'name', weight: 2 },
          { name: 'pascal', weight: 1 },
          { name: 'category', weight: 0.5 },
        ],
        threshold: 0.35,
        ignoreLocation: true,
      });

      let activeCategory = '';
      let activeQuery = '';

      function applyFilters(): void {
        let matches: Set<Element> | null = null;
        if (activeQuery) {
          matches = new Set(
            fuse.search(activeQuery).map((r) => cards.find((c) => c.dataset.name === r.item.name)),
          );
        }
        let visible = 0;
        for (const card of cards) {
          const show =
            (!activeCategory || card.dataset.category === activeCategory) &&
            (!matches || matches.has(card));
          card.hidden = !show;
          if (show) visible++;
        }
        countEl.textContent = `Showing ${visible} of ${cards.length} icons`;
        emptyEl.hidden = visible > 0;
        const hash = new URLSearchParams();
        if (activeQuery) hash.set('q', activeQuery);
        if (activeCategory) hash.set('category', activeCategory);
        history.replaceState(null, '', hash.toString() ? `#${hash}` : '#');
      }

      search.addEventListener('input', () => {
        activeQuery = search.value.trim().toLowerCase();
        applyFilters();
      });

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.toggle('is-active', c === chip));
          activeCategory = chip.dataset.category ?? '';
          applyFilters();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== search) {
          e.preventDefault();
          search.focus();
        }
      });

      // --- modal -----------------------------------------------------------
      const modal = document.getElementById('modal') as HTMLDialogElement;
      const preview = document.getElementById('preview') as HTMLElement;
      const modalName = document.getElementById('modal-name') as HTMLElement;
      const modalMeta = document.getElementById('modal-meta') as HTMLElement;
      const download = document.getElementById('download') as HTMLAnchorElement;
      let currentCard: HTMLButtonElement | null = null;
      let currentSize = 64;

      function standaloneSvg(card: HTMLButtonElement, fill: string): string {
        const svg = card.querySelector('svg')!.cloneNode(true) as SVGElement;
        svg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
        svg.setAttribute('width', '100%');
        svg.setAttribute('height', '100%');
        svg.querySelectorAll('[fill="currentColor"]').forEach((el) => el.setAttribute('fill', fill));
        return svg.outerHTML;
      }

      function snippets(card: HTMLButtonElement): Record<string, string> {
        const pascal = card.dataset.pascal!;
        const name = card.dataset.name!;
        return {
          svg: standaloneSvg(card, '#000000'),
          react: `import { ${pascal} } from '@doodle-icons/react';\n\nexport function Example() {\n  return <${pascal} size={64} />;\n}`,
          vue: `import { ${pascal} } from '@doodle-icons/vue';\n\n<template>\n  <${pascal} :size="64" />\n</template>`,
          rn: `import { ${pascal} } from '@doodle-icons/react-native';\n\nexport const Example = () => (\n  <${pascal} size={64} />\n);`,
          flutter: `import 'package:doodle_icons/doodle_icons.dart';\n\nconst ${pascal}(width: 64, height: 64)`,
        };
      }

      function openModal(card: HTMLButtonElement): void {
        currentCard = card;
        modalName.textContent = card.dataset.name!;
        modalMeta.textContent = `${card.dataset.category} · viewBox "${card.dataset.viewbox}" · export ${card.dataset.pascal}`;
        preview.replaceChildren(card.querySelector('svg')!.cloneNode(true));
        applySize();
        const blob = new Blob([standaloneSvg(card, '#000000')], { type: 'image/svg+xml' });
        download.href = URL.createObjectURL(blob);
        download.download = `${card.dataset.name}.svg`;
        modal.showModal();
      }

      function applySize(): void {
        const svg = preview.querySelector('svg');
        if (svg) {
          svg.setAttribute('width', String(currentSize));
          svg.setAttribute('height', String(currentSize));
        }
      }

      cards.forEach((card) => card.addEventListener('click', () => openModal(card)));
      document.getElementById('modal-close')!.addEventListener('click', () => modal.close());

      document.querySelectorAll<HTMLButtonElement>('.sizes button').forEach((btn) =>
        btn.addEventListener('click', () => {
          document.querySelectorAll('.sizes button').forEach((b) => b.classList.toggle('is-active', b === btn));
          currentSize = Number(btn.dataset.size);
          applySize();
        }),
      );

      const flash = (el: HTMLElement, text: string): void => {
        const original = el.textContent;
        el.textContent = 'Copied!';
        setTimeout(() => (el.textContent = original), 1200);
      };

      document.querySelectorAll<HTMLButtonElement>('#copy-grid button').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (!currentCard) return;
          navigator.clipboard.writeText(snippets(currentCard)[btn.dataset.what!]).then(() => flash(btn, 'Copied!'));
        }),
      );

      // --- theme -----------------------------------------------------------
      const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement;
      const stored = localStorage.getItem('doodle-theme');
      if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
      themeToggle.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('doodle-theme', next);
      });

      // --- initial state from hash -----------------------------------------
      const params = new URLSearchParams(location.hash.slice(1));
      const q = params.get('q');
      const category = params.get('category');
      if (q) {
        search.value = q;
        activeQuery = q.toLowerCase();
      }
      if (category) {
        activeCategory = category;
        chips.forEach((c) => c.classList.toggle('is-active', c.dataset.category === category));
      }
      applyFilters();
    </script>
    <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
  </body>
</html>
