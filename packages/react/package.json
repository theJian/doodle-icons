{
  "name": "@doodle-icons/react",
  "version": "0.1.0",
  "description": "Hand-drawn doodle icons for React. 400+ handcrafted icons across 15 categories.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun ../../scripts/build-react.ts"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "keywords": ["icons", "svg", "doodle", "hand-drawn", "react"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theJian/doodle-icons.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/theJian/doodle-icons#readme"
}
