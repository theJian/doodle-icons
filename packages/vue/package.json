{
  "name": "@doodle-icons/vue",
  "version": "0.1.0",
  "description": "Hand-drawn doodle icons for Vue 3. 451 icons across 15 categories.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
