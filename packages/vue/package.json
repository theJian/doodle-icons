    "vue": "^3.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vue": "^3.5.0"
  },
  "keywords": ["icons", "svg", "doodle", "hand-drawn", "vue"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jian/doodle-icons.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/jian/doodle-icons#readme"
}
