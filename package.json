{
  "name": "doodle-icons",
  "version": "0.1.0",
  "private": true,
  "description": "A hand-drawn doodle icon library. Monorepo for React, React Native, Vue, SolidJS and Flutter packages plus the docs site.",
  "license": "(MIT AND CC0-1.0)",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun run build:metadata && bun run build:react && bun run build:react-native && bun run build:vue && bun run build:solid && bun run build:flutter",
    "build:metadata": "bun scripts/build-metadata.ts",
    "build:react": "bun scripts/build-react.ts",
    "build:react-native": "bun scripts/build-react-native.ts",
    "build:vue": "bun scripts/build-vue.ts",
    "build:solid": "bun scripts/build-solid.ts",
    "build:flutter": "bun scripts/build-flutter.ts",
    "dev:site": "bun run --filter '@doodle-icons/site' dev",
    "build:site": "bun run --filter '@doodle-icons/site' build",
    "preview:site": "bun run --filter '@doodle-icons/site' preview",
    "test": "bun scripts/generation-test.ts && bun scripts/smoke-test.tsx && bun scripts/tree-shaking-test.ts && node scripts/solid-test.mjs && node --conditions=browser scripts/solid-browser-test.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^3.3.11",
    "@vue/server-renderer": "^3.5.0",
    "babel-preset-solid": "^1.9.15",
    "esbuild": "^0.27.7",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solid-js": "^1.9.15",
    "svgo": "^4.1.0",
    "typescript": "^5.7.0",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.2.2",
    "vue": "^3.5.0"
  }
}
