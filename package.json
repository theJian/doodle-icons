{
  "name": "doodle-icons",
  "version": "0.1.0",
  "private": true,
  "description": "A hand-drawn doodle icon library. Monorepo for React, React Native, Vue and Flutter packages plus the docs site.",
  "license": "(MIT AND CC0-1.0)",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun run build:metadata && bun run build:react && bun run build:react-native && bun run build:vue && bun run build:flutter",
    "build:metadata": "bun scripts/build-metadata.ts",
    "build:react": "bun scripts/build-react.ts",
    "build:react-native": "bun scripts/build-react-native.ts",
    "build:vue": "bun scripts/build-vue.ts",
    "build:flutter": "bun scripts/build-flutter.ts",
    "dev:site": "bun run --filter '@doodle-icons/site' dev",
    "build:site": "bun run --filter '@doodle-icons/site' build",
    "preview:site": "bun run --filter '@doodle-icons/site' preview",
    "test": "bun scripts/smoke-test.tsx && bun scripts/tree-shaking-test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@vue/server-renderer": "^3.5.0",
    "esbuild": "^0.27.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.0",
    "vue": "^3.5.0"
  }
}
